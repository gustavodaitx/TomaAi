rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ============================================================
    // FUNÇÕES GERAIS E AUXILIARES
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsExisting() {
      return signedIn() && resource.data.usuarioId == request.auth.uid;
    }

    function perfilAtual() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil;
    }

    function ehCuidador() {
      return signedIn() && (
        perfilAtual() == 'CUIDADOR' || 
        perfilAtual() == 'PESSOA_DE_CONFIANCA'
      );
    }

    // Verifica se a Pessoa de Confiança / Cuidador possui vínculo ativo com o paciente
    function cuidadorVinculado(pacienteUid) {
      let vinculoPath = /databases/$(database)/documents/vinculos/$(pacienteUid + '_' + request.auth.uid);
      return ehCuidador() 
        && exists(vinculoPath) 
        && get(vinculoPath).data.ativo == true;
    }


    // ============================================================
    // USUÁRIOS
    // ============================================================

    match /usuarios/{userId} {

      allow read: if signedIn();

      // Permite a criação do próprio documento de usuário autenticado
      allow create: if owns(userId)
        && request.resource.data.id == userId
        && request.resource.data.perfil in ['PACIENTE', 'PESSOA_DE_CONFIANCA', 'CUIDADOR'];

      // Permite atualização de campos (ex: codigoPaciente, telefone, responsavelPadraoId) pelo próprio dono
      allow update: if owns(userId);

      allow delete: if false;
    }


    // ============================================================
    // MEDICAMENTOS
    // ============================================================

    match /medicamentos/{medicamentoId} {

      // Leitura: O próprio Paciente OU a Pessoa de Confiança vinculada
      allow read: if signedIn() && (
        resource.data.usuarioId == request.auth.uid ||
        cuidadorVinculado(resource.data.usuarioId)
      );

      // Escrita (Criar/Editar/Excluir): Apenas o Paciente dono do registro
      allow create: if signedIn() 
        && request.resource.data.usuarioId == request.auth.uid;

      allow update, delete: if ownsExisting();
    }


    // ============================================================
    // HORÁRIOS DOS MEDICAMENTOS
    // ============================================================

    match /horarios_medicamentos/{horarioId} {

      // Leitura: O próprio Paciente OU a Pessoa de Confiança vinculada
      allow read: if signedIn() && (
        resource.data.usuarioId == request.auth.uid ||
        cuidadorVinculado(resource.data.usuarioId)
      );

      // Criar: Apenas o Paciente dono do medicamento
      allow create: if signedIn()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.medicamentoId is string
        && exists(/databases/$(database)/documents/medicamentos/$(request.resource.data.medicamentoId))
        && get(/databases/$(database)/documents/medicamentos/$(request.resource.data.medicamentoId)).data.usuarioId == request.auth.uid;

      // Editar/Excluir: Apenas o Paciente dono
      allow update, delete: if ownsExisting();
    }


    // ============================================================
    // DOSES DA AGENDA
    // ============================================================

    match /doses/{doseId} {

      // Leitura: O próprio Paciente OU a Pessoa de Confiança vinculada
      allow read: if signedIn() && (
        resource.data.usuarioId == request.auth.uid ||
        cuidadorVinculado(resource.data.usuarioId)
      );

      // Criar Doses (Geração diária/automática): Paciente logado
      allow create: if signedIn() 
        && request.resource.data.usuarioId == request.auth.uid;

      // Atualizar status da dose (ex: marcar como tomada): Paciente ou Pessoa de Confiança vinculada
      allow update: if signedIn() && (
        resource.data.usuarioId == request.auth.uid ||
        cuidadorVinculado(resource.data.usuarioId)
      );

      // Excluir Doses: Apenas o Paciente
      allow delete: if ownsExisting();
    }


    // ============================================================
    // PESSOAS DE CONFIANÇA
    // ============================================================

    match /pessoas_confianca/{pessoaId} {
      allow read, delete: if ownsExisting();

      allow create: if signedIn()
        && request.resource.data.usuarioId == request.auth.uid;

      allow update: if ownsExisting()
        && request.resource.data.usuarioId == resource.data.usuarioId;
    }


    // ============================================================
    // CÓDIGOS DE VÍNCULO
    // ============================================================

    match /codigos_vinculo/{codigoId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn();
    }


    // ============================================================
    // VÍNCULOS
    // ============================================================

    match /vinculos/{vinculoId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }


    // ============================================================
    // BLOQUEIO PADRÃO
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}